# Game data and build outputs are far too large for Git.
0ad-data/
0ad-data-min/
0ad-data-menu/
0ad-*.tar.xz

# Upstream libraries/artifacts are restored by docs/BUILD_ANDROID.md.
0ad-0.28.0/binaries/
0ad-0.28.0/build/
0ad-0.28.0/libraries/

# Android build outputs and packaged data.
android/assets/
android/jniLibs/
android/app.apk
android/*.apk
android/app-release.apk
android/*.idsig
android/.gradle/
